#!/usr/bin/env python3
"""Test stub codeql: `codeql database analyze <db> <suite> --format=... --output=<sarif> ...`.

Writes a small SARIF (one rule with a CWE tag; one result with an explicit
level, one using the rule default, one without a location).
Env: STUB_CODEQL_MODE=fail -> exit 1 with an error on stderr, no SARIF.
"""
import json
import os
import sys

argv = sys.argv[1:]
if os.environ.get("STUB_CODEQL_MODE") == "fail":
    sys.stderr.write("A fatal error occurred: database is not finalized\n")
    sys.exit(1)
out = next(a.split("=", 1)[1] for a in argv if a.startswith("--output="))
sarif = {"version": "2.1.0", "runs": [{
    "tool": {"driver": {"name": "CodeQL", "rules": [
        {"id": "cpp/double-free", "properties": {"tags": ["security", "external/cwe/cwe-415"]},
         "defaultConfiguration": {"level": "error"}},
        {"id": "cpp/weak", "properties": {"tags": []}},
    ]}},
    "results": [
        {"ruleId": "cpp/double-free", "level": "warning", "message": {"text": " freed twice "},
         "locations": [{"physicalLocation": {"artifactLocation": {"uri": "parser.c"},
                                             "region": {"startLine": 33, "endLine": 33}}}]},
        {"ruleId": "cpp/double-free", "message": {"text": "default level"},
         "locations": [{"physicalLocation": {"artifactLocation": {"uri": "parser.c"},
                                             "region": {"startLine": 32}}}]},
        {"ruleId": "cpp/weak", "message": {"text": "no location"}, "locations": []},
    ]}]}
with open(out, "w") as f:
    json.dump(sarif, f)
