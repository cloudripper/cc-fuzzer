{
  "schema": "fuzz-config/v3",
  "fuzz_forks": 2,
  "harnesses": [
    {
      "name": "parser",
      "entry_function": "parse_chunk"
    },
    {
      "name": "encoder",
      "entry_function": "encode_chunk"
    }
  ],
  "fuzzer_slots": [
    {
      "slot": "parser-main",
      "harness": "parser",
      "engine": "libfuzzer"
    },
    {
      "slot": "encoder-afl",
      "harness": "encoder",
      "engine": "aflpp",
      "role": "master",
      "afl_power_schedule": "explore",
      "timeout_ms": 1000
    }
  ],
  "tick": {
    "consult_every_n": 5,
    "consult_on_coverage_stall": true
  },
  "code_review": {
    "enabled": true,
    "default_tier": "sonnet",
    "scan_paths": null,
    "excluded_paths": [
      "tests/",
      "vendor/"
    ],
    "max_functions_to_review": 20,
    "sast": {
      "mode": "auto",
      "codeql_db": null
    }
  }
}
