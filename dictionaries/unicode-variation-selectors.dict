# cc-fuzzer dictionary: Unicode Variation Selectors (practical subset)
#
# libFuzzer / AFL++ dictionary format. One token per line.
# Values are byte sequences (UTF-8 encoded). \xNN escapes are honored.
#
# Variation selectors are zero-width Unicode codepoints that modify the
# rendering of the preceding character. They have legitimate uses (CJK glyph
# variants, emoji presentation) but are also a known channel for invisible
# data smuggling and parser confusion.
#
# This is the *practical subset* used in the wild. The full VS1-VS256 + IVS
# range lives in unicode-variation-selectors-full.dict (3000+ entries, opt-in).
#
# Reference: https://paulbutler.org/2025/smuggling-arbitrary-data-through-an-emoji/
# Reference: https://www.unicode.org/charts/PDF/UFE00.pdf
# Reference: https://www.unicode.org/Public/UCD/latest/ucd/StandardizedVariants.txt

# === Variation Selectors 1-16 (U+FE00..U+FE0F) ===
# Used for CJK glyph variants and emoji presentation
"\xef\xb8\x80"   # VS1 (U+FE00)
"\xef\xb8\x81"   # VS2
"\xef\xb8\x82"   # VS3
"\xef\xb8\x83"   # VS4
"\xef\xb8\x84"   # VS5
"\xef\xb8\x85"   # VS6
"\xef\xb8\x86"   # VS7
"\xef\xb8\x87"   # VS8
"\xef\xb8\x88"   # VS9
"\xef\xb8\x89"   # VS10
"\xef\xb8\x8a"   # VS11
"\xef\xb8\x8b"   # VS12
"\xef\xb8\x8c"   # VS13
"\xef\xb8\x8d"   # VS14
"\xef\xb8\x8e"   # VS15 (text presentation selector)
"\xef\xb8\x8f"   # VS16 (emoji presentation selector)

# === Sample IVS (Ideographic Variation Selectors) U+E0100..U+E01EF ===
# 4-byte UTF-8 sequences - the smuggling channel
"\xf3\xa0\x84\x80"   # VS17 (U+E0100) - first IVS
"\xf3\xa0\x84\x81"   # VS18
"\xf3\xa0\x84\x90"   # VS33
"\xf3\xa0\x84\xa0"   # VS49
"\xf3\xa0\x87\xaf"   # VS256 (U+E01EF) - last IVS

# === Zero-Width Joiners / Non-Joiners ===
# Critical for emoji ZWJ sequences and parser confusion
"\xe2\x80\x8c"   # ZWNJ (U+200C)
"\xe2\x80\x8d"   # ZWJ (U+200D)

# === Combining marks (zero-width modifications) ===
"\xcc\x80"       # combining grave (U+0300)
"\xcc\x81"       # combining acute (U+0301)
"\xcc\xa0"       # combining left half ring below (U+0320)

# === Common emoji that take VS modifiers ===
# Useful as anchor characters for VS-bearing inputs
"\xe2\x98\x80"           # sun (U+2600) - takes VS15/VS16
"\xe2\x99\xa5"           # heart (U+2665)
"\xe2\x9c\x8c"           # victory hand (U+270C)
"\xf0\x9f\x98\x80"       # grinning face (U+1F600)
"\xf0\x9f\x91\x8d"       # thumbs up (U+1F44D)

# === Common ZWJ emoji sequences (multi-codepoint glyphs) ===
"\xf0\x9f\x91\xa8\xe2\x80\x8d\xf0\x9f\x91\xa9\xe2\x80\x8d\xf0\x9f\x91\xa6"   # family man+woman+boy
"\xf0\x9f\x91\xa9\xe2\x80\x8d\xf0\x9f\x92\xbb"                              # woman technologist

# === Emoji + VS combinations (the smuggling pattern) ===
# emoji followed immediately by an IVS - this is the article's payload shape
"\xe2\x98\x80\xf3\xa0\x84\x80"               # sun + VS17
"\xe2\x9c\x8c\xf3\xa0\x84\x90"               # victory hand + VS33
"\xf0\x9f\x98\x80\xf3\xa0\x84\xa0"           # grinning + VS49
"\xf0\x9f\x91\x8d\xf3\xa0\x87\xaf"           # thumbs up + VS256

# === Tag characters U+E0001..U+E007F (smuggling channel) ===
# Each is 4-byte UTF-8. These are deprecated but still parsed by many libs.
"\xf3\xa0\x80\x81"   # LANGUAGE TAG (U+E0001)
"\xf3\xa0\x81\xa0"   # TAG SPACE (U+E0020)
"\xf3\xa0\x81\xa1"   # TAG LATIN SMALL LETTER A (U+E0061)
"\xf3\xa0\x81\xb0"   # TAG digit 0 (U+E0030)
"\xf3\xa0\x81\xbf"   # CANCEL TAG (U+E007F)
