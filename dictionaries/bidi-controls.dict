# cc-fuzzer dictionary: Unicode bidirectional control characters
#
# Source code, comment, and string parsing bugs related to bidi controls.
# These are at the heart of Trojan Source attacks (CVE-2021-42574) and
# affect any tool that displays user-controlled text.
#
# Reference: https://trojansource.codes/
# Reference: https://www.unicode.org/reports/tr9/

# === Explicit directional formatting (deprecated but parsed) ===
# LRE  Left-to-Right Embedding (U+202A)
"\xe2\x80\xaa"
# RLE  Right-to-Left Embedding (U+202B)
"\xe2\x80\xab"
# PDF  Pop Directional Formatting (U+202C)
"\xe2\x80\xac"
# LRO  Left-to-Right Override (U+202D)
"\xe2\x80\xad"
# RLO  Right-to-Left Override (U+202E)
"\xe2\x80\xae"

# === Implicit directional formatting ===
# LRM  Left-to-Right Mark (U+200E)
"\xe2\x80\x8e"
# RLM  Right-to-Left Mark (U+200F)
"\xe2\x80\x8f"

# === Directional isolates (Trojan Source) ===
# LRI  Left-to-Right Isolate (U+2066)
"\xe2\x81\xa6"
# RLI  Right-to-Left Isolate (U+2067)
"\xe2\x81\xa7"
# FSI  First Strong Isolate (U+2068)
"\xe2\x81\xa8"
# PDI  Pop Directional Isolate (U+2069)
"\xe2\x81\xa9"

# === Arabic directional marks ===
# ARABIC LETTER MARK (U+061C)
"\xd8\x9c"

# === Common Trojan Source sequence ===
# RLO + benign text + PDI - flips display order
# standalone RLO
"\xe2\x80\xae"
# nested isolate sequence
"\xe2\x81\xa6\xe2\x81\xa7\xe2\x81\xa9\xe2\x81\xa9"
